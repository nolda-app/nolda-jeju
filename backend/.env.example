OPENAI_API_KEY=
# 코스 생성 모델 (기본 gpt-5-mini) / 추론 강도 (gpt-5 계열 기본 minimal — 가장 빠름)
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=minimal

SUPABASE_URL=
SUPABASE_KEY=

# 제주 장소 수집 (scripts/collect_visitjeju.py) — 비짓제주 Open API 키
VISITJEJU_API_KEY=

# 장소 좌표 Geocoding (scripts/build_places_geo.py) — NCP Maps 앱 키, Geocoding 사용 설정 필요
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=

# 도보 경로 (scripts/build_walk_legs.py) — 둘 중 하나, ORS 우선
TMAP_APP_KEY=
# ORS_API_KEY=

# 로그인 (카카오) — Kakao Developers > 내 애플리케이션 > 앱 키 / 카카오 로그인
JWT_SECRET=
KAKAO_CLIENT_ID=
# 카카오 로그인 > 보안 에서 Client Secret 활성화했다면 필수
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/login/kakao/callback

# Phase 2 (네이버 로그인 도입 시 사용)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 구글 — 로그인과 유튜브 취향 분석이 같은 OAuth 클라이언트(GOOGLE_CLIENT_ID/SECRET)를 공유하되
# 리디렉션 URI는 용도별로 따로 등록 (Google Cloud Console > 사용자 인증 정보 > 승인된 리디렉션 URI에 둘 다 추가)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/login/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
# 분석 후 돌아갈 프론트 주소
# FRONTEND_URL=http://localhost:5173

# 업체 대표사진 업로드 (scripts/scrape_place_images.py) — Supabase Storage S3 호환 접근
# 대시보드 Storage > images 버킷은 Public으로 설정돼있어야 공개 URL로 서빙됨
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=images
SUPABASE_S3_REGION=
